# ─────────────────────────────────────────────────────────────────────────
# CourtDraft AI — конфигурация
#
# Единственное место, где живут различия между машинами (п.61 ТЗ).
# Скопируйте в .env и правьте под свою машину. Сам .env в git НЕ попадает.
#
#   DEVELOPMENT (ноутбук 8 GB, CPU only, без GPU):
#     LLM_PROVIDER=mock
#     EMBEDDING_PROVIDER=mock
#     OLLAMA_ENABLED=false
#
#   RUNTIME (компьютер с RTX 3050):
#     LLM_PROVIDER=ollama
#     EMBEDDING_PROVIDER=local
#     OLLAMA_ENABLED=true
#     OLLAMA_MODEL=qwen3.5:4b
#
# Переключение MOCK -> REAL не должно требовать правки кода.
# ─────────────────────────────────────────────────────────────────────────

# ── Приложение ────────────────────────────────────────────────────────────
APP_NAME=CourtDraft AI
APP_ENV=development          # development | runtime
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

# ── Режим ИИ (главный переключатель MOCK/REAL) ────────────────────────────
# mock | ollama | openai
LLM_PROVIDER=mock
# mock | local
EMBEDDING_PROVIDER=mock

# ── Ollama (нужен только в RUNTIME) ───────────────────────────────────────
OLLAMA_ENABLED=false
# Из контейнера Docker к Ollama на хосте — так и оставить.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SEC=120
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.1

# ── OpenAI-совместимый провайдер (ZvenoAI / DeepSeek Flash) ───────────────
# Включается LLM_PROVIDER=openai. Ключ хранится только в .env, который
# в .gitignore. В .env.example ключа нет и быть не должно.
OPENAI_BASE_URL=https://api.zveno.ai/v1
OPENAI_API_KEY=
OPENAI_MODEL=deepseek/deepseek-v4-flash-0731
# Автовыбор самой дешёвой модели DeepSeek Flash по размеру запроса.
OPENAI_MODEL_AUTO=true
OPENAI_MODEL_FILTER=deepseek
OPENAI_EXPECTED_OUT_TOKENS=300
OPENAI_TIMEOUT_SEC=120
OPENAI_MAX_TOKENS=700
OPENAI_TEMPERATURE=0.1
OPENAI_RETRIES=2
OPENAI_RETRY_DELAY=0.6
OPENAI_REASONING_EFFORT=none
# Цены-заглушки, ₽ за 1M токенов, если /models недоступен.
OPENAI_PRICE_IN=8.3899704
OPENAI_PRICE_OUT=27.0644205
OPENAI_PRICE_CACHE=2.706442
OPENAI_PRICE_TTL_SEC=21600

# ── Квота на сильную модель (только для теста на людях) ──────────────────
# Первым N делам выдаётся сильная модель, остальным — быстрая. Назначение
# фиксируется за делом и не меняется при повторной генерации. Для первого
# этапа теста (все на слабой) оставьте STRONG_MODEL_QUOTA=0, перед вторым
# этапом поставьте нужное число и перезапустите backend.
MODEL_ROUTING_ENABLED=false
STRONG_MODEL=
WEAK_MODEL=
STRONG_MODEL_QUOTA=0

# ── OCR сканированных PDF (локально, без облака) ──────────────────────────
# Нужен внешний Tesseract + языки rus/eng. Если язык лежит не в каталоге
# установки, укажите каталог здесь (без прав администратора).
OCR_ENABLED=true
OCR_LANGUAGES=rus+eng
OCR_TESSDATA_DIR=
OCR_DPI=200
# Меньше этого числа символов = текстового слоя нет, пробуем OCR.
OCR_MIN_CHARS=200
OCR_MAX_PAGES=30

# ── Кэш ответов модели ────────────────────────────────────────────────────
RESPONSE_CACHE_ENABLED=true
RESPONSE_CACHE_TTL_SECONDS=3600
RESPONSE_CACHE_MAX_ENTRIES=128
# Пусто — только в памяти. Путь — кэш переживает перезапуск.
RESPONSE_CACHE_PATH=

# ── Смысловой фильтр инструкций (необязательно) ──────────────────────────
# Требует transformers + torch. Модель: либо готовая Prompt Guard
# (meta-llama/Llama-Prompt-Guard-2-86M, нужна лицензия), либо своя
# дообученная: scripts/build_injection_dataset.py +
# scripts/finetune_injection_guard.py (см. docs/injection-guard-finetune.md).
INJECTION_GUARD_ENABLED=false
INJECTION_GUARD_MODEL=meta-llama/Llama-Prompt-Guard-2-86M
INJECTION_GUARD_THRESHOLD=0.5
# Ollama не обязателен для старта backend: см. раздел EMBEDDINGS ниже.

# ── Embeddings ────────────────────────────────────────────────────────────
# Размерность вектора. Меняйте ОДНОВРЕМЕННО с моделью эмбеддингов.
EMBEDDING_DIM=1024
EMBEDDING_MODEL=bge-m3
# Система обязана стартовать и без модели эмбеддингов, печатая
# "Embedding provider unavailable. System is running in degraded/mock mode."
EMBEDDINGS_OPTIONAL=true

# ── База данных ──────────────────────────────────────────────────────────
# Два диалекта, один код:
#   - development без PostgreSQL -> sqlite+aiosqlite (по умолчанию)
#   - runtime на RTX 3050         -> postgresql+asyncpg
#
# Если задать DATABASE_URL явно, он имеет приоритет над POSTGRES_*.
# Пока DATABASE_URL пуст, а POSTGRES_* равны значениям ниже, система
# выбирает SQLite — на ноутбуке PostgreSQL не установлен, а Docker
# недоступен, и падать при старте было бы хуже, чем работать на файле.
#
# Для PostgreSQL (после Фазы 3 на машине с БД):
#   DATABASE_URL=postgresql+asyncpg://courtdraft:courtdraft@localhost:5432/courtdraft
# Для SQLite явно:
#   DATABASE_URL=sqlite+aiosqlite:///./data/cases/courtdraft.db
DATABASE_URL=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=courtdraft
POSTGRES_USER=courtdraft
POSTGRES_PASSWORD=courtdraft

# ── Qdrant ────────────────────────────────────────────────────────────────
# На ноутбуке используется встроенный режим (QDRANT_MODE=memory),
# чтобы не поднимать сервер. Сервер нужен только для RTX 3050.
QDRANT_MODE=memory           # memory | server
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_LAWS=legal_laws
QDRANT_COLLECTION_CASES=legal_cases
QDRANT_COLLECTION_DOCS=case_documents

# ── RAG ───────────────────────────────────────────────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=10
RETRIEVAL_CANDIDATES=50
# Веса для Reciprocal Rank Fusion (п.25)
RRF_K=60

# ── Ограничения ресурсов (п.54 — консервативно для 8 GB RAM) ───────────────
MAX_UPLOAD_MB=50
EMBEDDING_BATCH_SIZE=16
CONCURRENCY_LIMIT=2
REQUEST_TIMEOUT_SEC=300

# ── Хранилище файлов ──────────────────────────────────────────────────────
# Пути относительны к корню репозитория (НЕ к текущему каталогу):
# запуск из backend/ не должен создавать data/ внутри backend/.
STORAGE_DIR=./data/cases
DOCUMENTS_DIR=./data/cases/documents
DEMO_DIR=./data/demo
LAWS_DIR=./backend/data/laws
TEMPLATES_DIR=./data/templates

# ── CORS (только локально, п.44 LOCAL ONLY) ───────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Никаких внешних LLM/embedding API. Оставьте пустым — система обязана
# работать без интернета.

# ── Обезличивание (п.45) ──────────────────────────────────────────────────
PII_ANONYMIZE_DEMO=true

# ── Оценка качества (п.63) ────────────────────────────────────────────────
EVAL_CASES=20
EVAL_TOP_K=5
